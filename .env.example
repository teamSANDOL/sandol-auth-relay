DEBUG=False

BASE_URL=https://relay.example.com
JWT_SECRET=dev-jwt-secret-please-change
LIT_ISSUER=auth-relay
LIT_AUDIENCE=myapp
STATE_TTL_SECONDS=600
CHATBOT_CALLBACK_TIMEOUT_SECONDS=8.0
RELAY_TO_CHATBOT_HMAC_SECRET=dev-hmac-secret-please-change
# issue_login_link 호출자 서명 검증: off | warn(기본, 실패해도 통과·경고 로그) | enforce(실패 시 401)
ISSUE_LINK_AUTH_MODE=warn
ISSUE_LINK_AUTH_SKEW_SECONDS=300
# client별 요청 서명 비밀(<CLIENT_KEY 대문자·_>__ISSUE_LINK_SECRET). 호출자(kakao-bot)의 RELAY_ISSUE_LINK_SECRET과 같은 값
SANDOL_KAKAO_BOT__ISSUE_LINK_SECRET=dev-issue-link-secret-please-change
REDIRECT_ALLOWLIST=/
KAKAO_BOT_APP_ID=
KAKAO_WEBHOOK_PRIMARY_ADMIN_KEY=
KAKAO_WEBHOOK_ALLOWED_ADMIN_KEYS=
